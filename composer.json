{
  "name": "vinnyrags/vincentragostaio",
  "description": "Personal website",
  "type": "project",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.vincentragosta.io"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "composer/installers": "^1.12 || ^2.0",
    "johnpbloch/wordpress": "^7.1",
    "wpengine/advanced-custom-fields-pro": "^6.8",
    "ext-dom": "*",
    "wpackagist-plugin/wpforms-lite": "^2.0",
    "wpackagist-plugin/wordpress-seo": "^28.7",
    "wpackagist-plugin/relevanssi": "^4.28",
    "vincentragosta/mythus": "^1.2",
    "vincentragosta/ix": "^1.7",
    "wpackagist-plugin/instagram-feed": "^6.10",
    "wpackagist-plugin/wp-graphql": "^2.24",
    "wpackagist-plugin/wpgraphql-acf": "^3.0",
    "wpackagist-plugin/redis-cache": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "ItzenzoTTV\\": "wp-content/mu-plugins/itzenzottv/src/"
    }
  },
  "extra": {
    "wordpress-install-dir": "wp",
    "installer-paths": {
      "wp-content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@reinstall-nested"
    ],
    "post-update-cmd": [
      "@reinstall-nested"
    ],
    "reinstall-nested": [
      "@composer install --working-dir=wp-content/mu-plugins/mythus --no-interaction",
      "@composer install --working-dir=wp-content/themes/ix --no-interaction"
    ]
  }
}
