{# Site footer — rendered from the resolved `footer` content partial
   (Appearance → Partials; per-page override under "Header & Footer").
   No partial (or mode = Disabled) renders no footer. #}
{% if footer_partial %}
    <footer class="footer site-footer site-footer--{{ footer_partial.slug }}" data-partial-id="{{ footer_partial.id }}">
        <div class="footer__inner">
            {{ footer_partial.content | raw }}
        </div>
    </footer>
{% endif %}
