{# Site header — rendered from the resolved `header` content partial
   (Appearance → Partials; per-page override under "Header & Footer").
   The partial's block content owns the layout: site title, navigation,
   search, and CTA. No partial (or mode = Disabled) renders no header. #}
{% if header_partial %}
    <header class="header site-header site-header--{{ header_partial.slug }}" data-partial-id="{{ header_partial.id }}">
        <div class="header__container">
            {{ header_partial.content | raw }}
        </div>
    </header>
{% endif %}
