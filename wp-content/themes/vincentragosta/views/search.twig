{% extends "base.twig" %}

{#
    Search results (search.php). Pills filter by type server-side
    (?post_type=); counts come from SearchResults. Rows share the archive
    index look; excerpts carry Relevanssi's <strong> highlights.
#}

{% block content %}
    <section class="search-hero has-grid-backdrop alignfull">
        <div class="search-hero__inner">
            <p class="is-style-eyebrow">Search</p>
            <h1 class="search-hero__title">
                {% if query %}
                    Results for <em class="serif-accent">“{{ query }}”</em>
                {% else %}
                    Search the <em class="serif-accent">site</em><mark class="accent-highlight">.</mark>
                {% endif %}
            </h1>
            {% if query %}<p class="search-hero__summary">{{ summary }}</p>{% endif %}
            <div class="search-hero__form">{{ search_form | raw }}</div>
        </div>
    </section>

    {% if query %}
        {% if pills|length > 1 %}
        <nav class="search-toolbar" aria-label="Filter results by type">
            <ul class="search-toolbar__filters" role="list">
                {% for pill in pills %}
                    <li>
                        <a class="search-pill" href="{{ site.url }}/?s={{ query|url_encode }}{{ pill.type ? '&post_type=' ~ pill.type : '' }}"{{ pill.active ? ' aria-current="page"' }}>
                            {{ pill.label }} <span class="search-pill__count">{{ pill.count }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}

        {% if rows %}
            <ol class="search-results" role="list">
                {% for row in rows %}
                    <li class="search-row">
                        <a class="search-row__link" href="{{ row.link }}">
                            <span class="search-row__type">{{ row.label }}</span>
                            <span class="search-row__body">
                                <span class="search-row__title">{{ row.title }}</span>
                                {% if row.excerpt %}<span class="search-row__excerpt">{{ row.excerpt | raw }}</span>{% endif %}
                            </span>
                            <span class="search-row__meta">{{ row.meta }}</span>
                            <span class="search-row__go" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 9l6-6M4 3h5v5"/></svg></span>
                        </a>
                    </li>
                {% endfor %}
            </ol>

            {% if pagination %}
                <nav class="search-pagination" aria-label="Search results pages">
                    <ul role="list">
                        {% for link in pagination %}<li>{{ link | raw }}</li>{% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% else %}
            <div class="search-empty">
                <p class="search-empty__message">Nothing matched <strong>“{{ query }}”</strong>{{ active ? ' in this section' : '' }}. Try fewer or different words — or start somewhere below.</p>
            </div>
        {% endif %}
    {% endif %}

    {% if not query or not rows %}
        <div class="search-paths">
            {% for path in [
                { href: '/projects/', label: 'Projects', note: 'Every build, grouped by year.' },
                { href: '/nous-signal/', label: 'Nous Signal', note: 'A daily read on the machine economy.' },
                { href: '/framework/', label: 'The Framework', note: 'What every site runs on.' },
            ] %}
                <div class="wp-block-group is-style-panel">
                    <p class="is-style-eyebrow">{{ '%02d'|format(loop.index) }}</p>
                    <h2 class="wp-block-heading has-40-font-size"><a href="{{ site.url }}{{ path.href }}">{{ path.label }}</a></h2>
                    <p class="is-style-muted has-20-font-size">{{ path.note }}</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
