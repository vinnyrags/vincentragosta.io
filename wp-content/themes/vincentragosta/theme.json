{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "1440px",
      "wideSize": "1600px"
    },
    "custom": {
      "layout": {
        "narrow": "1200px",
        "wide": "1600px"
      },
      "borderRadius": "16px",
      "color": {
        "error": "#e74c3c",
        "brandTwitch": "#9146ff",
        "brandYoutube": "#ff0000",
        "brandTiktok": "#00f2ea",
        "brandInstagram": "#e4405f",
        "brandDiscord": "#5865f2"
      },
      "iconSize": {
        "xs": "10px",
        "sm": "16px",
        "md": "36px",
        "lg": "48px"
      },
      "radius": {
        "sm": "5px",
        "md": "8px",
        "lg": "16px",
        "xl": "24px"
      },
      "tracking": {
        "display": "-0.045em",
        "heading": "-0.03em",
        "tight": "-0.015em",
        "label": "0.06em"
      }
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "20",
          "slug": "20",
          "size": "0.5rem"
        },
        {
          "name": "30",
          "slug": "30",
          "size": "1rem"
        },
        {
          "name": "40",
          "slug": "40",
          "size": "1.5rem"
        },
        {
          "name": "50",
          "slug": "50",
          "size": "2.5rem"
        },
        {
          "name": "60",
          "slug": "60",
          "size": "4rem"
        },
        {
          "name": "65",
          "slug": "65",
          "size": "clamp(4rem, 15vw, 7rem)"
        },
        {
          "name": "70",
          "slug": "70",
          "size": "clamp(6rem, 15vw, 20rem)"
        }
      ]
    },
    "color": {
      "palette": [
        {
          "color": "#ededee",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#08090a",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#d4ff3a",
          "name": "Accent 1",
          "slug": "accent-1"
        },
        {
          "color": "#101113",
          "name": "Grey 1 (panel)",
          "slug": "grey-1"
        },
        {
          "color": "#141518",
          "name": "Panel 2",
          "slug": "panel-2"
        },
        {
          "color": "#1f2124",
          "name": "Grey 2 (line)",
          "slug": "grey-2"
        },
        {
          "color": "#9a9ca3",
          "name": "Grey 3 (muted)",
          "slug": "grey-3"
        },
        {
          "color": "#2a2c30",
          "name": "Grey 4 (line strong)",
          "slug": "grey-4"
        },
        {
          "color": "#7d8086",
          "name": "Grey 5 (dim)",
          "slug": "grey-5"
        },
        {
          "color": "#ff3333",
          "name": "Nous Red",
          "slug": "nous-red"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "fluid": false,
          "name": "13px",
          "size": "0.8125rem",
          "slug": "10"
        },
        {
          "fluid": false,
          "name": "15px",
          "size": "0.9375rem",
          "slug": "20"
        },
        {
          "fluid": {
            "min": "1.0625rem",
            "max": "1.1875rem"
          },
          "name": "17px / 19px",
          "size": "1.1875rem",
          "slug": "30"
        },
        {
          "fluid": {
            "min": "1.125rem",
            "max": "1.3125rem"
          },
          "name": "18px / 21px",
          "size": "1.3125rem",
          "slug": "40"
        },
        {
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "24px / 32px",
          "size": "2rem",
          "slug": "50"
        },
        {
          "fluid": {
            "min": "2rem",
            "max": "3.375rem"
          },
          "name": "32px / 54px",
          "size": "3.375rem",
          "slug": "60"
        },
        {
          "fluid": {
            "min": "2.75rem",
            "max": "4.5rem"
          },
          "name": "44px / 72px",
          "size": "4.5rem",
          "slug": "70"
        },
        {
          "fluid": {
            "min": "2.5rem",
            "max": "6rem"
          },
          "name": "56px / 96px",
          "size": "6rem",
          "slug": "80"
        },
        {
          "fluid": {
            "min": "2.75rem",
            "max": "8.5rem"
          },
          "name": "64px / 136px",
          "size": "8.5rem",
          "slug": "90"
        },
        {
          "fluid": {
            "min": "3rem",
            "max": "9.375rem"
          },
          "name": "72px / 150px",
          "size": "9.375rem",
          "slug": "100"
        }
      ],
      "fontFamilies": [
        {
          "name": "Sans (Inter Tight)",
          "slug": "sans",
          "fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter Tight",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/inter-tight/inter-tight-400.woff2"
              ]
            },
            {
              "fontFamily": "Inter Tight",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/inter-tight/inter-tight-500.woff2"
              ]
            },
            {
              "fontFamily": "Inter Tight",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/inter-tight/inter-tight-600.woff2"
              ]
            }
          ]
        },
        {
          "name": "Serif (Instrument Serif)",
          "slug": "serif",
          "fontFamily": "\"Instrument Serif\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/instrument-serif/instrument-serif-400.woff2"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/instrument-serif/instrument-serif-400-italic.woff2"
              ]
            }
          ]
        },
        {
          "name": "Mono (JetBrains Mono)",
          "slug": "mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/jetbrains-mono/jetbrains-mono-400.woff2"
              ]
            },
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./src/Providers/Theme/assets/fonts/jetbrains-mono/jetbrains-mono-500.woff2"
              ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|contrast",
      "text": "var:preset|color|base"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|30",
      "fontWeight": "400",
      "letterSpacing": "-0.005em",
      "lineHeight": "1.55"
    },
    "blocks": {
      "core/button": {
        "typography": {
          "fontSize": "var:preset|font-size|20",
          "fontWeight": "500"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/column": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/cover": {
        "spacing": {
          "blockGap": "var:preset|spacing|50",
          "padding": {
            "top": "var:preset|spacing|50",
            "right": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|50",
            "left": "var:preset|spacing|40"
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/separator": {
        "border": {
          "width": "1px"
        },
        "color": {
          "text": "var:preset|color|grey-2"
        }
      }
    },
    "elements": {
      "button": {
        "border": {
          "radius": "var(--wp--custom--radius--md)",
          "width": "1px",
          "style": "solid",
          "color": "var:preset|color|accent-1"
        },
        "color": {
          "background": "var:preset|color|accent-1",
          "text": "var:preset|color|contrast"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "right": "1.125rem",
            "bottom": "0.625rem",
            "left": "1.125rem"
          }
        },
        ":focus": {
          "outline": {
            "offset": "2px",
            "color": "var:preset|color|accent-1",
            "width": "2px",
            "style": "solid"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
          },
          "border": {
            "color": "var:preset|color|base"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|20",
          "fontWeight": "500",
          "letterSpacing": "-0.005em"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "500",
          "lineHeight": "1.02",
          "letterSpacing": "var(--wp--custom--tracking--heading)",
          "fontSize": "var:preset|font-size|60"
        },
        "color": {
          "text": "var:preset|color|base"
        }
      },
      "link": {
        "color": {
          "text": "currentColor"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent-1"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|90",
          "lineHeight": "0.92",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|70",
          "lineHeight": "1",
          "letterSpacing": "var(--wp--custom--tracking--display)"
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono",
          "fontSize": "var:preset|font-size|10"
        },
        "color": {
          "text": "var:preset|color|grey-5"
        }
      }
    }
  }
}
