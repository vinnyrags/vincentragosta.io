<?xml version="1.0"?>
<ruleset name="vincentragosta">
    <description>WordPress VIP coding standards for the child theme. Errors fail CI; warnings are reported only.</description>

    <file>src</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="minimum_wp_version" value="6.5"/>

    <rule ref="WordPress-VIP-Go"/>

    <!--
        Baseline exclusions. Each is scoped to the narrowest path that holds the pattern and
        carries the reason it is safe, so new code anywhere else is held to the full standard.
    -->

    <!-- Block render.php files are included inside WP_Block::render(), a method scope:
         $mode, $posts, $term and $tag there are locals, never WordPress's globals. -->
    <rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
        <exclude-pattern>*/blocks/*/render.php</exclude-pattern>
    </rule>

    <!-- Unbounded queries over small, editor-curated sets (projects, the blog archive and its carrier hero).
         VIP forbids posts_per_page -1 for sites with unbounded content; these are not. -->
    <rule ref="WordPressVIPMinimum.Performance.NoPaging">
        <exclude-pattern>*/Providers/Project/*</exclude-pattern>
        <exclude-pattern>*/Providers/Blog/blocks/blog/render.php</exclude-pattern>
        <exclude-pattern>*/Providers/Blog/blocks/nous-carrier/render.php</exclude-pattern>
    </rule>

</ruleset>
